// ============================================================
// HAVOC SUPLEMENTOS — schema.prisma
// Single Tenant | PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  OPERADOR
  VISUALIZADOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  PAYMENT_LINK
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum CheckoutPaymentMethod {
  PIX
  CREDIT_CARD
  CASH
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatSessionStatus {
  NOVO_ATENDIMENTO
  EM_ANDAMENTO
  AGUARDANDO_PAGAMENTO
  ATENDIMENTO_HUMANO
  FINALIZADO
  CANCELADO
}

enum StorefrontConsultantMessageRole {
  USER
  ASSISTANT
}

enum ShippingType {
  BY_CEP
  BY_REGION
  BY_WEIGHT
}

enum ProductLabelStatus {
  PENDING
  PROCESSING
  SOURCE_MATCHED
  NOT_FOUND
  FAILED
}

// ============================================================
// USUÁRIOS & AUTH
// ============================================================

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(OPERADOR)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  orders       Order[]
  chatSessions ChatSession[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ============================================================
// CATÁLOGO
// ============================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([slug])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  description     String?
  unit            String    @default("UN")
  price           Decimal   @db.Decimal(10, 2)
  cost_price      Decimal?  @db.Decimal(10, 2)
  price_wholesale Decimal?  @db.Decimal(10, 2)
  stock           Int       @default(0)
  stock_min       Int       @default(0)
  ncm             String?
  cfop            String?
  sku             String?   @unique
  imageUrl        String?
  imageKey        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  categories Category[]
  labelFacts ProductLabel?

  kitItems   KitItem[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([deletedAt])
  @@index([isActive])
  @@map("products")
}

model ProductLabel {
  id                   String             @id @default(uuid())
  manufacturer         String?
  manufacturerDomain   String?
  sourceUrl            String?
  sourceTitle          String?
  sourceRetrievedAt    DateTime?
  sourceHash           String?
  evidence             Json?
  servingSize          String?
  servingsPerContainer String?
  usageInstructions    String?            @db.Text
  ingredients          String?            @db.Text
  allergenStatement    String?            @db.Text
  warnings             Json?
  nutritionFacts       Json?
  exactProductMatch    Boolean            @default(false)
  status               ProductLabelStatus @default(NOT_FOUND)
  version              Int                @default(1)
  identityHash         String?
  syncAttemptCount     Int                @default(0)
  lastSyncAttemptAt    DateTime?
  nextSyncAt           DateTime?
  lastSyncErrorCode    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, exactProductMatch])
  @@index([nextSyncAt])
  @@map("product_labels")
}

model Kit {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  imageUrl      String?
  imageKey      String?
  discountType  String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue Decimal   @default(0) @db.Decimal(10, 2)
  finalPrice    Decimal   @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  items      KitItem[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([deletedAt])
  @@map("kits")
}

model KitItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([kitId, productId])
  @@map("kit_items")
}

// ============================================================
// PEDIDOS
// ============================================================
model Order {
  id     String      @id @default(uuid())
  code   String      @unique // ex: HAV-00001
  status OrderStatus @default(PENDING)

  // 👉 ADICIONE ESTES CAMPOS (Dados cruciais do cliente)
  customerName    String
  customerPhone   String
  customerCpf     String? // Opcional, útil para PIX/Nota Fiscal
  deliveryAddress String?
  deliveryMethod  DeliveryMethod?
  paymentMethod   CheckoutPaymentMethod?

  subtotal     Decimal   @db.Decimal(10, 2)
  shippingCost Decimal   @default(0) @db.Decimal(10, 2)
  discount     Decimal   @default(0) @db.Decimal(10, 2)
  total        Decimal   @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // 👉 Deixe opcional: Representa qual funcionário ajudou neste pedido (se houver)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  shippingRuleId String?
  shippingRule   ShippingRule? @relation(fields: [shippingRuleId], references: [id])

  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([code])
  @@index([customerPhone]) // Bom para buscas rápidas
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  kitId String?
  kit   Kit?    @relation(fields: [kitId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================================
// PAGAMENTOS (Banco Digital)
// ============================================================

model Payment {
  id             String        @id @default(uuid())
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  pixCode        String?       @db.Text // copia-e-cola
  pixQrCodeUrl   String? // URL da imagem do QR Code
  paymentLink    String?
  externalId     String?       @unique // ID retornado pelo banco digital
  providerStatus String?
  statusDetail   String?
  webhookPayload Json? // payload cru do webhook
  paidAt         DateTime?
  expiresAt      DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  events        PaymentEvent[]
  notifications PaymentNotification[]

  @@index([status])
  @@index([externalId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentEvent {
  id                 String             @id @default(uuid())
  deduplicationKey   String             @unique
  providerPaymentId  String
  type               String
  status             PaymentEventStatus @default(RECEIVED)
  payload            Json
  error              String?            @db.Text
  receivedAt         DateTime            @default(now())
  processedAt        DateTime?

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([providerPaymentId])
  @@index([status])
  @@index([receivedAt])
  @@map("payment_events")
}

model PaymentNotification {
  id        String                    @id @default(uuid())
  type      String
  channel   String
  recipient String
  status    PaymentNotificationStatus @default(PENDING)
  error     String?                   @db.Text
  sentAt    DateTime?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, type, channel])
  @@index([status])
  @@index([createdAt])
  @@map("payment_notifications")
}

// ============================================================
// CHATBOT
// ============================================================

model ChatSession {
  id                 String            @id @default(uuid())
  sessionKey         String            @unique @default(uuid())
  customerName       String?
  isActive           Boolean           @default(true)
  recoveryAttempts   Int               @default(0)
  status             ChatSessionStatus @default(NOVO_ATENDIMENTO)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  handoffRequestedAt DateTime?
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])

  messages ChatMessage[]

  @@index([sessionKey])
  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String          @id @default(uuid())
  role      ChatMessageRole
  content   String          @db.Text
  tokens    Int? // tokens consumidos (controle de custo)
  createdAt DateTime        @default(now())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ChatbotConfig {
  id              String   @id @default(uuid())
  systemPrompt    String   @db.Text
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(500)
  fallbackMessage String   @db.Text
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("chatbot_config")
}

// Public storefront consultant data is intentionally isolated from WhatsApp chat data.
model StorefrontConsultantSession {
  id        String   @id @default(uuid())
  clientId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages StorefrontConsultantMessage[]

  @@index([clientId])
  @@index([expiresAt])
  @@map("storefront_consultant_sessions")
}

model StorefrontConsultantMessage {
  id              String                          @id @default(uuid())
  role            StorefrontConsultantMessageRole
  content         String                          @db.Text
  requestId       String
  context         Json?
  recommendations Json?
  createdAt       DateTime                        @default(now())

  sessionId String
  session   StorefrontConsultantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, requestId, role])
  @@index([sessionId, createdAt])
  @@map("storefront_consultant_messages")
}

// ============================================================
// FRETE
// ============================================================

model ShippingRule {
  id            String       @id @default(uuid())
  name          String
  type          ShippingType
  cep           String? // CEP exato ou prefixo
  region        String? // ex: "SP", "Sul", "Nordeste"
  minWeight     Float? // kg
  maxWeight     Float? // kg
  price         Decimal      @db.Decimal(10, 2)
  estimatedDays Int          @default(7)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders Order[]

  @@index([type])
  @@index([isActive])
  @@map("shipping_rules")
}

// ============================================================
// AUDITORIA
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  action    String // ex: "USER_LOGIN", "PRODUCT_CREATED", "PAYMENT_CONFIRMED"
  entity    String? // ex: "Product", "Order"
  entityId  String?
  payload   Json? // dados relevantes da ação
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
