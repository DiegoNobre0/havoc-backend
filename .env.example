NODE_ENV=dev
PORT=3333
DATABASE_URL=postgresql://user:password@localhost:5432/havoc_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-16-characters

# Required in production for Mercado Pago checkout and webhook confirmation.
API_PUBLIC_URL=https://api.havocsuplementos.shop
STOREFRONT_URL=https://havocsuplementos.shop
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-replace-me
MERCADO_PAGO_WEBHOOK_SECRET=replace-me

# Required in production for proactive payment confirmation on WhatsApp.
META_ACCESS_TOKEN=replace-me
META_PHONE_ID=replace-me
META_PAYMENT_CONFIRMED_TEMPLATE=pagamento_confirmado
META_ORDER_PROCESSING_TEMPLATE=pedido_em_preparacao
META_ORDER_SHIPPED_TEMPLATE=pedido_saiu_entrega
META_ORDER_READY_PICKUP_TEMPLATE=pedido_pronto_retirada
